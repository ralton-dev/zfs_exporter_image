{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ralton-dev/.github"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard — zfs_exporter_image",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the upstream pdf/zfs_exporter binary bundled in the image.",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG ZFS_EXPORTER_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "pdf/zfs_exporter",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    }
  ]
}
